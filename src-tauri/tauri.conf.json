{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "vcmp-browser",
  "version": "1.0.4",
  "identifier": "vcmp.browser",
  "build": {
    "beforeDevCommand": "npm run vite-dev",
    "beforeBuildCommand": "npm run vite-build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VCMP Browser",
        "width": 1067,
        "height": 600,
        "minWidth": 1067,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "copyright": "",
    "shortDescription": "",
    "longDescription": "",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "dialogImagePath": "wix\\dialogImage.bmp",
        "bannerPath": "wix\\bannerImage.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://browserupdate.spiller.ovh/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzOURGRkRFQ0ExMUE3NEIKUldSTHB4SEszditkRTJWTG50cm1BbjRLS0lnYkszNTFXUFVqR1oyMzZaRGYwN2dnWjltazV5TnkK",
      "windows": {
        "installMode": "basicUi"
      }
    }
  }
}
